# Copy to .env for local testing. On Render, set these in the dashboard instead.
# VERIFY_TOKEN: any secret word you make up — Meta will send it back during webhook setup.
VERIFY_TOKEN=amar-gopon-token-123
# PAGE_ACCESS_TOKEN: from your Meta developer app (Page token for the 99 Shop Page).
PAGE_ACCESS_TOKEN=
# APP_SECRET: from the same Meta app (Settings -> Basic -> App Secret). Optional but recommended.
APP_SECRET=
# ADMIN_TOKEN: password for viewing /orders and /refresh.
ADMIN_TOKEN=amar-admin-456
# GEMINI_API_KEY: ছবি দিয়ে খোঁজার জন্য (Google AI Studio থেকে ফ্রি চাবি)।
# না থাকলে লেখা মেসেজ ঠিকই চলবে, শুধু ছবি পাঠালে "এখনো চালু হয়নি" বলবে।
# চাবি নিতে: aistudio.google.com → Get API key → Create API key (কার্ড লাগে না)।
GEMINI_API_KEY=
# GEMINI_MODELS: ছবি দেখার মডেল, কমা দিয়ে পরপর কয়েকটা দেওয়া যায়।
# প্রথমটা ব্যস্ত/বন্ধ থাকলে সার্ভার ১ সেকেন্ড পর পরেরটা চেষ্টা করবে।
# Lite আগে: এখন এটাই নির্ভরযোগ্য, আর ফ্রি টিয়ারে দিনে ~৫০০ কল (Flash-এ ~২০)।
# ১ ছবি = ২ কল, তাই ফ্রি চাবিতে দিনে ~২৫০টা ছবি মেলানো যায়।
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# DRY_RUN=1: reply text is printed in logs instead of sent to Facebook (for testing).
DRY_RUN=1
PORT=3000
